# ---------------------------------------------------------------------------
# MNL backend — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL="postgresql://mnl_user:mnl_password@localhost:5432/mnl_db?schema=public"

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Redis (optional in Phase 1 — reserved for the future task queue)
REDIS_URL="redis://localhost:6379"

# Allowed browser origin for the future frontend
CORS_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug
